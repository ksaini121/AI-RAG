# Copy to .env and fill in real values:  cp .env.example .env
VERSION="0.1.0"

# Postgres connection (consumed by docker-compose.yml and app.core.config)
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=fastapi
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# JWT auth (consumed by app.core.config). Generate: openssl rand -hex 32
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# OpenAI (consumed by app.core.config) — no default, required
OPENAI_API_KEY=sk-replace-me
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# Chunking / retrieval
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5

# Uploads
UPLOAD_DIR=var/uploads
MAX_UPLOAD_BYTES=26214400

# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=ingestion

# CORS — JSON list of browser origins allowed to call the API
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Agent
AGENT_MAX_TOOL_ITERATIONS=8
HTTP_FETCH_TIMEOUT_SECONDS=10
HTTP_FETCH_MAX_BYTES=200000
